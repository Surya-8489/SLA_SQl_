#foreign key

create table managers_details(manager_id int primary key,
manager_name varchar(20),dep varchar(20)
);

desc managers_details;

create table employes(emp_id int primary key,
emp_name varchar(20),
dep varchar(20),
manager_id int,

foreign key (manager_id) references  managers_details(manager_id)
);
desc employes; 

